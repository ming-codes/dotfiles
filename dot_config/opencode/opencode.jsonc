{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "opencode-wakelock",
    "opencode-pty"
  ],
  "permission": {
    "external_directory": {
      "~/.config/**": "allow",
      "~/.local/**": "allow",
      "~/Workspace/**": "allow",
      "~/Sandbox/**": "allow"
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "enabled": false,
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect",
        "--user-data-dir",
        "{env:HOME}/Library/Application Support/BraveSoftware/Brave-Browser/"
      ]
    },
    "blender": {
      "type": "local",
      "enabled": false,
      "command": [
        "uvx",
        "blender-mcp"
      ]
    }
  }
}
