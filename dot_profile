eval "$(/opt/homebrew/bin/brew shellenv)"

export EDITOR=nvim

export XDG_CONFIG_HOME=$HOME/.config
export XDG_LOCAL_HOME=$HOME/.local
export XDG_DATA_HOME=$XDG_LOCAL_HOME/share

export CHEZMOI_HOME=$HOME/.local/share/chezmoi

export FZF_CONFIG_HOME=$XDG_CONFIG_HOME/fzf
export VD_CONFIG_HOME=$XDG_CONFIG_HOME/visidata
export ZSH_COMPLETION_HOME=$XDG_LOCAL_HOME/share/completions

export JRE_HOME=$JAVA_HOME

export VD_CONFIG="$VD_CONFIG_HOME/config.py"
export VD_DIR="$VD_CONFIG_HOME"

export FZF_DEFAULT_OPTS="--bind alt-a:select-all"
# Workaround for OpenCode markdown rendering issues in the terminal
# https://github.com/anomalyco/opencode/issues/17323
export OPENCODE_EXPERIMENTAL_MARKDOWN=0

export PATH=/opt/cisco/anyconnect/bin:$PATH
export PATH=$HOME/bin:$PATH
export PATH="$HOME/.yarn/bin:$HOME/.config/yarn/global/node_modules/.bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

export NODE_OPTIONS=--max_old_space_size=4096
